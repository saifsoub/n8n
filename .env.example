# n8n local operating stack
N8N_VERSION=latest
N8N_PORT=5678
# Management binds privately; access through an authenticated proxy or tunnel.
N8N_BIND_ADDRESS=127.0.0.1
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Dubai

# Required: generate locally with `openssl rand -base64 32`
N8N_ENCRYPTION_KEY=replace_with_generated_key

# PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=n8n

# Legacy DB mapping for compatibility
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USERNAME=n8n
DB_POSTGRESDB_PASSWORD=replace_with_local_password
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# Telegram approval workflow
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id

# Execution retention
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Privacy
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Use n8n owner accounts and private access; legacy basic-auth variables are not
# an access-control mechanism in current n8n releases.
